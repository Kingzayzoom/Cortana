# Server only. Never use NEXT_PUBLIC_ for these values.
# Use the actual secret key, with ElevenAgents / Conversational AI Write permission (convai_write).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Required to enable paid voice sessions: a private demo access code (at least 12 characters).
CORTANA_DEMO_ACCESS_CODE=
# Generate a random signing secret of at least 32 characters before hosting.
CORTANA_SESSION_SECRET=
# Optional: local durable data directory. Defaults to .cortana/ (single-node prototype).
# CORTANA_DATA_DIR=
# Optional: exact external origin(s) when using a reverse proxy, comma-separated.
# CORTANA_APP_ORIGIN=https://your-demo.example
# Required on Vercel (serverless): shared progress storage. Adding Upstash Redis
# from the Vercel Marketplace sets these automatically. Leave empty for local
# file storage in .cortana/. UPSTASH_REDIS_REST_URL/_TOKEN are also accepted.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Optional: key prefix so preview and production can share one database.
# CORTANA_REDIS_PREFIX=cortana
# Phone rounds (optional). Create the phone agent with scripts/configure-phone-agent.mjs
# after importing a Twilio number into ElevenLabs. See docs/phone-round.md.
# ELEVENLABS_PHONE_AGENT_ID=
# ELEVENLABS_PHONE_NUMBER_ID=
# Shared secret the phone agent sends back to this server's tools (32+ chars).
# CORTANA_PHONE_TOOL_SECRET=
# The deployed public origin, used when configuring the phone agent's tools.
# CORTANA_PUBLIC_URL=https://your-app.vercel.app
# Carrier for phone rounds: "twilio" (default, native ElevenLabs integration) or
# "sip" for a SIP trunk carrier such as Telnyx, Plivo or SignalWire.
# CORTANA_PHONE_PROVIDER=twilio
