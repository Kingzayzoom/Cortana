# Copy to .env.local. Everything here is server-only — never prefix with NEXT_PUBLIC_.

# Voice (ElevenLabs Agents). See docs/elevenlabs-setup.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Typed questions when voice is off (Gemini API).
GEMINI_API_KEY=
# Optional: pin a Flash-class model your project has quota for.
GEMINI_MODEL=gemini-flash-latest
