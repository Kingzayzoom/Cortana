# Copy to .env.local. Everything here is server-only: nothing uses NEXT_PUBLIC_.
# `node scripts/prepare-local.mjs` fills in the three generated secrets for you.
#
# Deployments configured before the rename may still use CORTANA_* names; every
# SAMANTHA_* setting falls back to its CORTANA_* twin (src/lib/server/env.ts).

# ── Core ─────────────────────────────────────────────────────────────────────
# Signs session cookies and phone sessions. 32+ random characters.
SAMANTHA_SESSION_SECRET=
# Required before anything that costs money (voice, calls). 12+ characters.
SAMANTHA_DEMO_ACCESS_CODE=
# Exact external origin(s), comma-separated, when behind a proxy. Also fixes the
# OAuth redirect URI across preview hosts.
# SAMANTHA_APP_ORIGIN=https://your-app.example

# ── Browser voice (docs/elevenlabs-setup.md) ─────────────────────────────────
# The secret key (sk_…), with ElevenAgents write permission (convai_write).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ── Storage ──────────────────────────────────────────────────────────────────
# Required on Vercel. Adding Upstash Redis from the Vercel Marketplace sets these;
# UPSTASH_REDIS_REST_URL/_TOKEN are accepted too. Leave empty locally to store
# profiles as files.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Key namespace. Defaults to "cortana", which existing profiles live under;
# change it only for a fresh database.
# SAMANTHA_REDIS_PREFIX=
# Local file storage directory. Defaults to .cortana/.
# SAMANTHA_DATA_DIR=

# ── Phone calls (docs/phone-setup.md) ────────────────────────────────────────
# ELEVENLABS_PHONE_AGENT_ID=
# ELEVENLABS_PHONE_NUMBER_ID=
# "twilio" (default) or "sip" for Telnyx, Plivo, SignalWire and other SIP trunks.
# SAMANTHA_PHONE_PROVIDER=twilio
# The phone agent sends this back on every tool call. 32+ characters.
# SAMANTHA_PHONE_TOOL_SECRET=
# Deployed origin, used by the scripts that configure the phone agents.
# SAMANTHA_PUBLIC_URL=https://your-app.vercel.app
# Only if Vercel deployment protection is on: its automation bypass secret.
# SAMANTHA_VERCEL_BYPASS=

# ── Front desk message from a call ───────────────────────────────────────────
# Without RESEND_API_KEY the agent says the feature isn't configured.
# RESEND_API_KEY=
# SAMANTHA_FRONT_DESK_EMAIL=frontdesk@your-clinic.example
# SAMANTHA_EMAIL_FROM=Samantha <onboarding@resend.dev>

# ── Google sign-in (optional) ────────────────────────────────────────────────
# OAuth 2.0 Web client. Register <origin>/api/auth/google/callback as a redirect
# URI. Leave blank to keep anonymous demo profiles only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Gmail morning briefing (optional, docs/features/email-summary.md) ────────
# Also needs GOOGLE_CLIENT_ID/SECRET above; it reuses the sign-in callback.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# Vercel Cron sends this as a Bearer token. 32+ characters.
# CRON_SECRET=

# ── Tooling only ─────────────────────────────────────────────────────────────
# Where the Playwright suites and verification scripts point.
# SAMANTHA_TEST_URL=http://localhost:3100
